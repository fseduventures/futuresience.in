{
  "name": "futurescience-site",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && node scripts/prerender.mjs && node scripts/optimize-images.mjs",
    "preview": "vite preview --port 4173",
    "start": "npm run build && vite preview --port 4173 --open",
    "brochure": "node scripts/make-brochure.mjs",
    "release": "npm run brochure && npm run build",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/sora": "^5.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "vite": "^5.4.11"
  }
}
